# Tokenization using spaCy

import spacy
nlp = spacy.load("en_core_web_sm")
text = "Natural Language Processing is a part of AI. It helps computers understand human language."
doc = nlp(text)
print("Sentence Tokenization:")
for sent in doc.sents:
    print(sent.text)
print("\nWord Tokenization:")
for token in doc:
    print(token.text)
